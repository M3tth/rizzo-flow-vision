{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rizzo-q8",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--no-sync", "rizzo", "serve", "--bits", "8"],
      "port": 8017
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8020",
        "--directory",
        "docs",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8020
    }
  ]
}
